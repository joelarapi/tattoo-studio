# Copy to .env and fill in. Variables marked (required) must be set for the app to start.

# --- Core ---------------------------------------------------------------------
# (required) Postgres connection string. Neon: use the *pooled* string (host contains "-pooler").
DATABASE_URI=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# (required) Long random string used by Payload to sign auth tokens. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# (required) Public URL of the site, no trailing slash. Used for canonicals, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for /api/preview (live preview / draft mode).
PREVIEW_SECRET=
# Secret for authenticated on-demand revalidation requests.
REVALIDATE_SECRET=
# Secret Vercel Cron sends to /api/payload-jobs/run (scheduled publishing). Not needed on a Node server.
CRON_SECRET=

# --- Seed (pnpm seed) -----------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Media storage: Cloudflare R2 (S3-compatible). Leave empty to store media on local disk ---
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public URL of the bucket (r2.dev URL or custom domain), used to serve files.
S3_PUBLIC_URL=
# A second, private bucket (no public access) for reference images attached to booking requests.
S3_PRIVATE_BUCKET=

# --- Email (Resend). Without a key, emails are printed to the console --------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. bookings@yourstudio.al
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Inbox that receives a notification for every new lead.
LEADS_NOTIFY_EMAIL=

# --- Cloudflare Turnstile (spam protection on the lead form) ------------------
# Development can use Cloudflare's test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tracking -------------------------------------------------------------------
# Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Meta Pixel / Dataset ID and Conversions API token (Events Manager > Settings)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: Events Manager "Test events" code, only while verifying CAPI.
META_CAPI_TEST_EVENT_CODE=
